# Copy to .env (git-ignored) and adjust. scripts/serve_models.sh and
# scripts/smoke_test.py read it. Paths are relative to the repository root.

# Inference engine: installed once per machine, pinned to build b11277.
LLAMA_SERVER=${HOME}/tools/llama.cpp/build/bin/llama-server
# Port of the model router. Its host is always 127.0.0.1.
LLAMA_PORT=8080
# The model the application asks for: a section of models.ini, qwen3.5-9b or qwen3.5-4b.
LLM_MODEL=qwen3.5-9b

# The Hugging Face cache lives in the project, not in ~/.cache. llama-server's
# router also lists the models it finds in this cache.
HF_HOME=models/hf

# Air gap: after scripts/download_models.py nothing needs the network.
# llama.cpp never downloads a model.
LLAMA_ARG_OFFLINE=1
# Hugging Face libraries run offline, with telemetry off.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# No tracing to hosted LangSmith; traces go to a self-hosted Phoenix.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
